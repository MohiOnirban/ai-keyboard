HOST=127.0.0.1
PORT=4000
AI_PROVIDER=mock
AI_ENABLED=true

AI_DAILY_LIMIT=20
AI_MAX_INPUT_TOKENS=12288
AI_MAX_OUTPUT_TOKENS=320
AI_TIMEOUT_MS=15000
AI_INSTALL_REQUESTS_PER_MINUTE=12
AI_IP_REQUESTS_PER_MINUTE=120
SESSION_CREATIONS_PER_IP_MINUTE=20
AI_INSTALL_CONCURRENCY=1
AI_GLOBAL_CONCURRENCY=20

# Optional durable database, required in production and for live AI.
# DATABASE_URL=postgresql://keyboard_api:password@host:5432/postgres
DATABASE_TLS=true
# DATABASE_CA_FILE=/path/to/database-root-ca.pem
# RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# TRUST_PROXY_CIDRS=127.0.0.1,::1
# MOCK_DATABASE_DIR=/path/to/local/mock/ledger

# OpenRouter settings. Zero prices and budgets keep live AI unavailable.
AI_MODEL=openai/gpt-6-luna
# OPENROUTER_API_KEY=
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_DAILY_BUDGET_USD=0
AI_MONTHLY_BUDGET_USD=0
